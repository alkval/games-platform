{
  "name": "alkval-games-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/server.ts",
    "build": "npm run db:generate && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/server.js",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/check-multiplayer.mjs",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "boardgame.io": "0.50.2",
    "chess.js": "^1.4.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "framer-motion": "13.0.0",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/passport": "1.0.17",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "9.2.4",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@koa/cors": "5.0.0",
    "socket.io": "4.8.3",
    "react-cookies": {
      "cookie": "0.7.2"
    },
    "svelte": "5.56.8"
  }
}
